{
  "name": "fit-arc-gym-backend",
  "version": "1.0.0",
  "description": "Backend API for FIT-ARC-GYM AI Fitness Platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate:wallet": "node scripts/migrateWallet.js",
    "test:unit": "node --test tests/unit.test.js tests/pricing.test.js",
    "test:api": "node --test tests/api.test.js",
    "test:wallet": "node --test --test-concurrency=1 tests/wallet.real.test.js",
    "test:wallet:integration": "node --test --test-concurrency=1 tests/wallet.integration.test.js",
    "test:wallet:simulation": "node tests/wallet_system.test.js",
    "test": "node --test --test-concurrency=1 tests/unit.test.js tests/pricing.test.js tests/api.test.js tests/wallet.real.test.js tests/wallet.integration.test.js && node tests/wallet_system.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.1",
    "multer": "^1.4.5-lts.1",
    "openai": "^7.0.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.4.3",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2"
  }
}
